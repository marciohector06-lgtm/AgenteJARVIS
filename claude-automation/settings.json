{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__jarvis-core__.*|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/claude-automation/hooks/guard-state-changing-tools.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(jarvis_backend/.env)",
      "Read(**/.env)",
      "Read(**/.wwebjs_auth/**)",
      "Read(**/jarvis.db)"
    ],
    "ask": [
      "Bash(pm2 restart:*)",
      "Bash(pm2 stop:*)",
      "Bash(pm2 delete:*)"
    ]
  }
}
