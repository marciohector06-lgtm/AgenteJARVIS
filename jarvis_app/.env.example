# URL do jarvis_backend (Express + Socket.io) alcançável pelo celular/emulador.
# - Em dev na mesma rede local: IP LAN da máquina que roda o backend (ex: 192.168.1.25).
# - Via Tailscale: IP 100.x.x.x do backend.
# Copie este arquivo para .env e ajuste o IP/porta conforme necessário.
EXPO_PUBLIC_SERVER_URL=http://192.168.1.25:4000
