{
  "name": "jarvis",
  "version": "0.1.0",
  "description": "Assistente Pessoal Autonomo (J.A.R.V.I.S) - acesso via Telegram",
  "main": "src/bot/telegram.js",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "start": "node src/bot/telegram.js",
    "dev": "node --watch src/bot/telegram.js",
    "start:server": "node src/server.js",
    "start:bg": "pm2 start ecosystem.config.cjs",
    "stop": "pm2 stop ecosystem.config.cjs",
    "restart": "pm2 restart ecosystem.config.cjs",
    "logs": "pm2 logs",
    "logs:whatsapp": "pm2 logs jarvis-whatsapp",
    "logs:server": "pm2 logs jarvis-server",
    "studio:login": "node scripts/studioLogin.mjs",
    "studio:session": "node scripts/studioLogin.mjs --status"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "1.2.2",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/tavily": "^1.2.0",
    "@supabase/supabase-js": "^2.115.0",
    "archiver": "^7.0.1",
    "archiver-zip-encrypted": "^2.0.0",
    "better-sqlite3": "^12.11.1",
    "chromadb": "^1.9.2",
    "dockerode": "^5.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.5.3",
    "mqtt": "^5.15.2",
    "net-snmp": "^3.26.3",
    "node-cron": "^4.6.0",
    "pdf-parse": "^2.4.5",
    "pm2": "^7.0.3",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.3",
    "ssh2": "^1.17.0",
    "telegraf": "^4.16.3",
    "wake_on_lan": "^1.0.0",
    "whatsapp-web.js": "^1.34.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
