# Copie este arquivo para .env e preencha os valores reais.
# Nunca commite o .env de verdade — já está no .gitignore.

# ── Núcleo (LLM) ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Busca web (scraper de conhecimento, viral_trend_search, tiktok_product_hunter)
TAVILY_API_KEY=

# ── WhatsApp (canal principal — src/bot/whatsapp.js) ────────────────────
# Número do dono do bot, só dígitos com DDI+DDD (ex: 55 61 99999-9999 -> 5561999999999).
# Usado como fallback de allowlist e como usuário "principal" do relatório semanal.
WHATSAPP_OWNER_NUMBER=5561999999999
# Números autorizados a falar com o bot, só dígitos, separados por vírgula.
ALLOWED_WHATSAPP_NUMBERS=5561999999999

# ── Telegram (legado — só usado por src/bot/telegram.js, que não sobe mais
# por padrão, e pelo alerta de falha do backup automático em disasterRecoveryTool.js) ──
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=

# ── Memória (SQLite + ChromaDB) ──────────────────────────────────────────
SQLITE_PATH=./jarvis.db
CHROMA_URL=http://localhost:8000
# Caminho do volume do Chroma no disco, usado só pelo backup automático.
CHROMA_PATH=./chroma-data

# ── App (Express + Socket.io — src/server.js) ───────────────────────────
PORT=4000
JWT_SECRET=
# PIN numérico usado pelo app pra trocar por um JWT em POST /auth/token.
DEVICE_PIN=

# ── Segurança de execução (guardExecution) ──────────────────────────────
# "true" pede confirmação (app ou WhatsApp/Telegram) antes de tools destrutivas.
REQUIRE_CONFIRM=true

# ── Crons proativos (todos "false" por padrão — mudam pra "true" pra ativar) ──
BRIEFING_ENABLED=false
MONITOR_ENABLED=false
FOLLOWUP_ENABLED=false
WEEKLY_ENABLED=false

# ── Monitor de infraestrutura (só lido se MONITOR_ENABLED=true) ─────────
# Lista "nome:host" separada por vírgula, ex: "servidor:192.168.1.10,site:exemplo.com"
MONITOR_HOSTS=
MONITOR_UPS_HOST=
MONITOR_UPS_OID=
MONITOR_UPS_BATTERY_VALUE=

# ── Backup automático (disaster_recovery_tool, cron diário 03:00) ──────
# Sem as duas, o backup automático fica desabilitado (mas o comando manual
# da tool ainda funciona se você passar os valores direto).
BACKUP_PASSWORD=
BACKUP_DESTINATION=

# ── Satélites (jarvis_satellite) ────────────────────────────────────────
# Idêntico ao SATELLITE_REGISTRATION_SECRET do .env de cada satélite.
SATELLITE_REGISTRATION_SECRET=

# ── Rede/PCs Windows (windows_remote_tool, windows_cleanup_tool, monitor) ──
# Lista "nome:hostTailscale" separada por vírgula, ex: "consultorio1:100.1.2.3"
# — usada por monitor.js e briefing.js pra checar os 13 PCs.
MONITORED_WINDOWS_PCS=

# ── Tailscale (tailscale_manager_tool) ──────────────────────────────────
# Opcionais: sem elas, list_devices/ping ainda funcionam via CLI local
# "tailscale status"; só são necessárias pra generate_install_script criar
# uma authkey de verdade via API (senão, gera com placeholder manual).
TAILSCALE_API_KEY=
TAILSCALE_TAILNET=

# ── Meta Ads (meta_ads_tool, monitor/briefing/weekly) ───────────────────
# Token de sistema/usuário com permissão ads_management e ads_read.
META_ACCESS_TOKEN=
# Com ou sem o prefixo "act_" — a tool completa se faltar.
META_AD_ACCOUNT_ID=
# Cron de monitoramento de Meta Ads (a cada 2h) — false por padrão.
META_ADS_MONITOR_ENABLED=false
# % de aumento de CPM que dispara alerta (padrão: 30).
META_CPM_ALERT_INCREASE_PERCENT=30
# CTR mínimo (%) antes de disparar alerta (padrão: 1).
META_CTR_ALERT_THRESHOLD=1

# ── Vercel (vercel_tool, briefing.js) ───────────────────────────────────
VERCEL_TOKEN=
# Só necessário se os projetos forem de um time (não conta pessoal).
VERCEL_TEAM_ID=
# Apelidos -> projectId real, JSON opcional: {"ShopSpy":"prj_xxx"}.
# Sem isso, "project" nas chamadas é tratado como nome/ID direto na Vercel.
VERCEL_PROJECTS=
# Projetos a incluir no briefing diário, separados por vírgula.
VERCEL_BRIEFING_PROJECTS=ShopSpy,TikTok Shop Revelado,UCB

# ── Supabase (supabase_tool) ─────────────────────────────────────────────
# Projeto único padrão (use isso OU SUPABASE_PROJECTS abaixo pra múltiplos).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Múltiplos projetos, JSON opcional: {"ShopSpy":{"url":"...","key":"..."}}.
SUPABASE_PROJECTS=

# ── Integrações opcionais ────────────────────────────────────────────────
# STT (transcrição de áudio via Whisper). Sem isso, mensagens de voz falham
# com erro explícito em vez de serem processadas como texto errado.
OPENAI_API_KEY=
# vMix (controle de câmera/replay via API HTTP local), só se for usar a tool.
VMIX_API_URL=http://127.0.0.1:8088/api/

# -- Camada de automacao MCP (/api/v1 + mcp-jarvis-core) -----------------
# Segredo compartilhado entre os processos jarvis-server e jarvis-whatsapp.
# O client do whatsapp-web.js e singleton do processo jarvis-whatsapp, entao o
# envio via MCP passa por uma ponte HTTP que escuta SO em loopback. Sem esta
# variavel a ponte nao sobe e o envio via MCP fica indisponivel (o bot
# continua funcionando normalmente).
WHATSAPP_BRIDGE_TOKEN=
WHATSAPP_BRIDGE_PORT=4010

# Credenciais WinRM usadas pelo catalogo de manutencao remota das clinicas.
# Ficam SO no cerebro: o cliente MCP nunca envia credencial. Sem elas, a rota
# POST /api/v1/network/remote-command responde 503 com motivo explicito.
WINDOWS_REMOTE_USERNAME=
WINDOWS_REMOTE_PASSWORD=
